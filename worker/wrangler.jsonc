{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yonmoque",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",

  // client/dist を同一オリジンで配信する。
  // run_worker_first に列挙したパスだけ Worker スクリプトが先に処理し、
  // それ以外は静的ファイル（無ければ index.html にフォールバック）を返す。
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },

  // 独自ドメイン。custom_domain: true にすると wrangler が
  // scriptarts.jp ゾーンの DNS レコードも作成・更新する。
  "routes": [
    { "pattern": "yonmoque.scriptarts.jp", "custom_domain": true }
  ],

  // routes を書くと workers_dev は自動的に false と解釈される。
  // 独自ドメインの設定が失敗したときに Worker へ到達する手段が
  // 一切なくなるため、明示的に true にして workers.dev を残す。
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yonmoque",
      // wrangler d1 create yonmoque / MCP で発行済み (APAC)
      "database_id": "148b94e5-e613-4b5a-a064-a4145e6f1a51"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "LOBBY", "class_name": "LobbyDurableObject" }
    ]
  },

  // 無料プランでは SQLite バックエンドの Durable Object のみ利用可能
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject", "LobbyDurableObject"]
    }
  ],

  "vars": {
    "ROOM_COUNT": "12",

    // --- CPU対戦AIの探索上限 ---
    //
    // 難易度ごとの値（ai.js の CPU_LEVELS）をこれ以下に切り詰める。
    // コードを変えずに CPU の負荷を下げたいときに使う。上げる方向には効かない。
    //
    // CPU_NODE_BUDGET は1手の思考で探索するノード数。CPU時間はおおむねこれに比例する。
    // 時間による打ち切りは使えない。Workers の Date.now() は「最後のI/Oの
    // 時刻」を返し、同期処理の途中では進まないため（サイドチャネル対策）。
    //
    // CPU_MAX_DEPTH は反復深化の深さの上限。届かなければ浅い結果を使うだけなので、
    // 上げても弱くはならない。
    //
    // 思考は Durable Object のアラーム1回の中で行う。Durable Object には無料プランでも
    // 10ms の CPU 制限がかからない（docs/cloudflare-cpu-limit.md）。
    // 実測値(Apple Silicon / 実戦局面): 30,000ノードで1手 中央値30ms・p95 37ms・最大73ms。
    // 本番の CPU はこの約3倍かかる。
    "CPU_MAX_DEPTH": "20",
    "CPU_NODE_BUDGET": "30000",

    // パスワードハッシュの反復回数
    "PBKDF2_ITERATIONS": "100000"
  }

  // SESSION_SECRET は vars ではなく Secret として登録する:
  //   npx wrangler secret put SESSION_SECRET
}
